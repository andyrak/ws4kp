# WeatherStar 4000+ Raspberry Pi Configuration
# Copy this file to ../.env and edit as needed.
# The setup script (pi/setup.sh) will generate this automatically.

# Server port
WS4KP_PORT=8080

# Kiosk mode: auto-loads the configured zip code on startup
KIOSK_MODE=1
KIOSK_ZIPCODE=90210

# Local directory containing music files (.mp3, .ogg, .m4a, .wav, .aac, .flac)
# Files in this directory are served at /audio/local/ and played in shuffled order.
# Leave empty to disable local audio, or set AUDIO_FILES for cloud-hosted URLs.
AUDIO_DIR=/home/pi/music

# Cloud-hosted audio files (comma-separated URLs). Only used if AUDIO_DIR is empty.
# AUDIO_FILES=https://example.com/track1.mp3,https://example.com/track2.mp3
